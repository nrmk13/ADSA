{
    "name": "@acme/ui",
    "version": "1.4.0",
    "description": "The same six components as ../design-system, documented the way an agent needs them.",
    "type": "module",
    "exports": {
        "./button": "./dist/button.js",
        "./card": "./dist/card.js",
        "./input": "./dist/input.js",
        "./table": "./dist/table.js",
        "./modal": "./dist/modal.js",
        "./badge": "./dist/badge.js",
        "./styles": "./dist/styles.css"
    },
    "peerDependencies": {
        "react": "^19",
        "tailwindcss": "^4"
    },
    "devDependencies": {
        "typescript": "^5.6"
    },
    "scripts": {
        "test": "node --test 'test/*.test.mjs'",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src scripts",
        "docs:props": "node scripts/props.mjs",
        "docs:a11y": "node scripts/a11y.mjs",
        "check:props": "node scripts/props.mjs --check",
        "check:a11y": "node scripts/a11y.mjs --check",
        "check:guidelines": "node scripts/guidelines.mjs",
        "check:examples": "node scripts/examples.mjs",
        "check:docs": "npm run check:guidelines && npm run check:props && npm run check:a11y && npm run check:examples",
        "test:storybook": "test-storybook --coverage",
        "gap:report": "node scripts/gap.mjs"
    }
}
