{
    "name": "adsa-cli",
    "version": "0.1.0",
    "description": "Score a design system on how well coding agents can use it, then fix what is missing.",
    "type": "module",
    "bin": {
        "adsa": "bin/adsa.mjs"
    },
    "files": [
        "bin",
        "lib",
        "rubric",
        "templates",
        "skills"
    ],
